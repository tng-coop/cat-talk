digraph IncompletenessUltimate {
    // -------------------------------------------------------------
    // VISUAL SETTINGS (The "Scroll of Truth")
    // -------------------------------------------------------------
    rankdir=TB; 
    nodesep=0.7;
    ranksep=0.9;
    splines=ortho; 
    fontname="Inter";
    pad=0.5;
    
    // Default Styling
    node [fontname="Inter", fontsize=11, shape=plain, style=filled, fillcolor="white"];
    edge [fontname="Inter", fontsize=10, color="#555555", penwidth=1.2, arrowhead=normal];

    // Titles
    Title [shape=plaintext, label="THE ULTIMATE MACHINE: HOW MATH BREAKS ITSELF\n(A Zero-Assumption Blueprint)", fontsize=24, fontcolor="#111111"];

    // -------------------------------------------------------------
    // MACHINE 1: THE TRANSLATOR (Alphabet to Numbers)
    // -------------------------------------------------------------
    subgraph cluster_M1 {
        label = "MACHINE 1: THE TRANSLATOR (Nothing is Magic, Everything is a List)";
        style="filled";
        color="#E3F2FD";
        
        // 1.1 The Alphabet
        Alphabet [label=<
            <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="white">
                <tr><td colspan="2" bgcolor="#BBDEFB"><b>STEP 1: THE ALPHABET</b></td></tr>
                <tr><td><b>We write math with these:</b></td><td><b>We save them as these:</b></td></tr>
                <tr><td>0 (Zero)</td><td>1</td></tr>
                <tr><td>S (Successor / +1)</td><td>3</td></tr>
                <tr><td>= (Equals)</td><td>5</td></tr>
                <tr><td>¬ (Not)</td><td>7</td></tr>
                <tr><td>( (Open)</td><td>13</td></tr>
                <tr><td>) (Close)</td><td>15</td></tr>
                <tr><td>v (Variable)</td><td>17</td></tr>
            </table>
        >];

        // 1.2 The Phrase
        Phrase [label=<
            <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="white">
                <tr><td colspan="7" bgcolor="#BBDEFB"><b>STEP 2: WRITE A SENTENCE</b></td></tr>
                <tr><td><b>Math:</b></td><td>¬</td><td>(</td><td>0</td><td>=</td><td>0</td><td>)</td></tr>
                <tr><td><b>Code:</b></td><td>7</td><td>13</td><td>1</td><td>5</td><td>1</td><td>15</td></tr>
            </table>
        >];

        // 1.3 The Zipper (Primes)
        Zipper [label=<
            <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="white">
                <tr><td colspan="2" bgcolor="#BBDEFB"><b>STEP 3: ZIP INTO ONE NUMBER</b></td></tr>
                <tr><td align="left">Rules:</td><td align="left">Take Prime Numbers (2, 3, 5, 7...)</td></tr>
                <tr><td align="left">Action:</td><td align="left">Put Codes as Exponents</td></tr>
                <tr><td align="left">Math:</td><td align="left">2<sup>7</sup> · 3<sup>13</sup> · 5<sup>1</sup> · 7<sup>5</sup> · 11<sup>1</sup> · 13<sup>15</sup></td></tr>
                <tr><td align="left"><b>RESULT:</b></td><td align="left"><b>24,794,911,296,000... (Number N)</b></td></tr>
            </table>
        >];

        Alphabet -> Phrase [label="use dictionary"];
        Phrase -> Zipper [label="encode"];
    }

    // -------------------------------------------------------------
    // MACHINE 2: THE CALCULATOR (Thinking is just Counting)
    // -------------------------------------------------------------
    subgraph cluster_M2 {
        label = "MACHINE 2: THE THINKER (Proofs are just Division)";
        style="filled";
        color="#E8F5E9";

        // 2.1 What is Thinking?
        Thinking [label=<
            <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="white">
                <tr><td bgcolor="#C8E6C9"><b>WHAT IS A "PROOF"?</b></td></tr>
                <tr><td align="left">A proof is just a list of sentences.</td></tr>
                <tr><td align="left">Since sentences are numbers...</td></tr>
                <tr><td align="left">A proof is just a LIST OF NUMBERS.</td></tr>
            </table>
        >];

        // 2.2 The Check
        Checker [label=<
            <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="white">
                <tr><td colspan="2" bgcolor="#C8E6C9"><b>HOW TO CHECK A PROOF (Without Eyes)</b></td></tr>
                <tr><td><b>Input:</b></td><td>Proof Number P, Sentence Number S</td></tr>
                <tr><td><b>Step 1:</b></td><td>Does P divide by 2? (Extract first step)</td></tr>
                <tr><td><b>Step 2:</b></td><td>Is Step 1 an Axiom? (Check simpler divisibility)</td></tr>
                <tr><td><b>Step 3:</b></td><td>Does Step 2 follow from Step 1? (Arithmetic relation)</td></tr>
                <tr><td><b>Step 4:</b></td><td>Is the last step S?</td></tr>
                <tr><td colspan="2"><b>THIS IS PURE ARITHMETIC. NO "MEANING" REQUIRED.</b></td></tr>
            </table>
        >];

        Zipper -> Thinking [label="N becomes data"];
        Thinking -> Checker [label="checking data"];
    }

    // -------------------------------------------------------------
    // MACHINE 3: THE CLONER (The Special Function)
    // -------------------------------------------------------------
    subgraph cluster_M3 {
        label = "MACHINE 3: THE CLONER (Substitution Step-by-Step)";
        style="filled";
        color="#F3E5F5";

        // 3.1 Function Def
        SubFunc [label=<
            <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="white">
                <tr><td colspan="2" bgcolor="#E1BEE7"><b>THE "CLONE" TOOL: sub(n, k)</b></td></tr>
                <tr><td align="left"><b>Goal:</b></td><td align="left">Put number K inside formula N</td></tr>
                <tr><td align="left"><b>Input N:</b></td><td align="left">Code for "v = 0" -&gt; &#91;17, 5, 1&#93;</td></tr>
                <tr><td align="left"><b>Input K:</b></td><td align="left">Number 1</td></tr>
                <tr><td align="left"><b>Action 1:</b></td><td align="left">Find 'v' (17) in list of N</td></tr>
                <tr><td align="left"><b>Action 2:</b></td><td align="left">Write K as "S(0)" -&gt; &#91;3, 13, 1, 15&#93;</td></tr>
                <tr><td align="left"><b>Action 3:</b></td><td align="left">Splice it in!</td></tr>
                <tr><td align="left"><b>Result:</b></td><td align="left">"S(0) = 0" -&gt; &#91;3, 13, 1, 15, 5, 1&#93;</td></tr>
            </table>
        >];

        Checker -> SubFunc [style=invis];
    }

    // -------------------------------------------------------------
    // MACHINE 4: THE TRAP (The Self-Reference)
    // -------------------------------------------------------------
    subgraph cluster_M4 {
        label = "MACHINE 4: THE TRAP (Making Logic Explode)";
        style="filled";
        color="#FFF3E0";

        // 4.1 The Formula
        StatementU [label=<
            <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="white">
                <tr><td bgcolor="#FFE0B2"><b>STEP 1: THE STATEMENT "U"</b></td></tr>
                <tr><td>Formula U(v): <b>"The formula #v CANNOT be proved"</b></td></tr>
                <tr><td>Code: <b>Let's call its code u.</b></td></tr>
            </table>
        >];

        // 4.2 The Twist
        Twist [label=<
            <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="white">
                <tr><td bgcolor="#FFE0B2"><b>STEP 2: THE TWIST</b></td></tr>
                <tr><td>We perform: <b>sub(u, u)</b></td></tr>
                <tr><td>Meaning: <b>"Put code u inside formula U(v)"</b></td></tr>
                <tr><td>Result: <b>Sentence G</b></td></tr>
            </table>
        >];

        // 4.3 The Result
        SelfRef [label=<
            <table border="0" cellborder="1" cellspacing="0" cellpadding="6" bgcolor="white">
                <tr><td colspan="2" bgcolor="#FFE0B2"><b>STEP 3: WHAT G SAYS</b></td></tr>
                <tr><td><b>Original U(v):</b></td><td>"Formula #v cannot be proved"</td></tr>
                <tr><td><b>After Twist:</b></td><td>"Formula #u (inside U) cannot be proved"</td></tr>
                <tr><td><b>Which means:</b></td><td>"THIS SENTENCE cannot be proved"</td></tr>
                <tr><td><b>G says:</b></td><td>"I AM UNPROVABLE"</td></tr>
            </table>
        >];

        SubFunc -> StatementU [label="uses sub"];
        StatementU -> Twist -> SelfRef;
    }

    // -------------------------------------------------------------
    // MACHINE 5: THE CRASH (Logic vs Truth)
    // -------------------------------------------------------------
    subgraph cluster_M5 {
        label = "MACHINE 5: THE CRASH (The End of Certainty)";
        style="filled";
        color="#FFEBEE";

        Comparison [label=<
            <table border="0" cellborder="1" cellspacing="0" cellpadding="10" bgcolor="white">
                <tr><td colspan="3" bgcolor="#FFCDD2"><b>THE FINAL JUDGMENT</b></td></tr>
                <tr><td><b>Question:</b></td><td colspan="2"><b>Can Math prove Sentence G?</b></td></tr>
                <tr><td><b>Scenario A: YES</b></td><td width="20">|</td><td><b>Scenario B: NO</b></td></tr>
                <tr><td>1. Math proves G.</td><td>|</td><td>1. Math fails to prove G.</td></tr>
                <tr><td>2. So G is TRUE.</td><td>|</td><td>2. G says "I am unprovable".</td></tr>
                <tr><td>3. But G says "I am UNPROVABLE"</td><td>|</td><td>3. So G is telling the truth.</td></tr>
                <tr><td>4. So Math proved a FALSEHOOD.</td><td>|</td><td>4. So G is a TRUE statement.</td></tr>
                <tr><td><b>RESULT: MATH IS BROKEN (Inconsistent)</b></td><td>|</td><td><b>RESULT: MATH IS BLIND (Incomplete)</b></td></tr>
            </table>
        >];

        Conclusion [label=<
            <table border="0" cellborder="1" cellspacing="0" cellpadding="8" bgcolor="#FFF9C4">
                <tr><td><b>CONCLUSION</b></td></tr>
                <tr><td>We assume Math is not broken (Scenario A is bad).</td></tr>
                <tr><td>Therefore, Scenario B must be real.</td></tr>
                <tr><td><b>THERE ARE TRUE THINGS THAT CANNOT BE PROVED.</b></td></tr>
            </table>
        >];

        SelfRef -> Comparison [label="examine"];
        Comparison -> Conclusion;
    }
}
